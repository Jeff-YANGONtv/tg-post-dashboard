# Supabase project URL and browser-safe anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only key. Never prefix this with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional fallback bot token. Prefer saving the token from the dashboard Settings page.
TELEGRAM_BOT_TOKEN=

# Optional fixed webhook secret. If omitted, Connect webhook creates and stores one in Supabase.
TELEGRAM_WEBHOOK_SECRET=
