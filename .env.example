# Supabase project URL and server-only service-role key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required to protect the scheduled-publishing endpoint
CRON_SECRET=replace-with-a-long-random-secret

# Optional fallback bot token. Prefer saving the token from the dashboard Settings page.
TELEGRAM_BOT_TOKEN=

# Optional fixed webhook secret. If omitted, Connect webhook creates and stores one in Supabase.
TELEGRAM_WEBHOOK_SECRET=
